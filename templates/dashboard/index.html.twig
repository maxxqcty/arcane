<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arcane Desk Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Custom Tailwind theme colors
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#db352b',
                        darkbg: '#181818'
                    }
                }
            }
        }
    </script>
</head>
<body class="flex bg-darkbg text-white min-h-screen">
    <!-- Sidebar -->
    <aside class="w-64 bg-darkbg shadow-md flex flex-col">
        <div class="p-6 border-b border-gray-700">
            <h1 class="text-2xl font-bold text-primary">ARCANE DESK</h1>
            <p class="text-gray-400 mt-1">Admin</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <a href="#" class="block p-2 rounded hover:bg-primary/20">Dashboard</a>
            <a href="#" class="block p-2 rounded hover:bg-primary/20">Services</a>
     <a href="{{ path('app_customer_index') }}" class="block p-2 rounded hover:bg-primary/20">User Management</a>
            <a href="#" class="block p-2 rounded hover:bg-primary/20">Computer Management</a>
            <a href="#" class="block p-2 rounded hover:bg-primary/20">Inventory</a>
            <a href="#" class="block p-2 rounded hover:bg-primary/20">Reports & Analytics</a>
            <a href="#" class="block p-2 rounded hover:bg-primary/20">System Settings</a>
        </nav>
        <div class="p-4 border-t border-gray-700">
            <button class="w-full flex justify-between items-center p-2 rounded hover:bg-primary/20">
                Notifications <span class="bg-primary text-white rounded-full px-2 text-xs">3</span>
            </button>
            <button class="w-full mt-2 p-2 rounded hover:bg-primary/20">Logout</button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-6">
        <h2 class="text-3xl font-bold mb-4 text-primary">Dashboard</h2>
        <p>Welcome to Arcane Desk Admin Panel!</p>
    </main>
</body>
</html>
