{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="flex flex-col h-full bg-[#181818] text-white font-roboto">

  <!-- Header -->
  <div class="p-6 border-b border-gray-700">
    <h1 class="font-oswald text-3xl mb-2">ADMIN DASHBOARD</h1>
    <p class="text-gray-400">Welcome back, Administrator. Here's your system overview.</p>
  </div>

  <!-- Key Metrics -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 p-6">

    <div class="bg-[#222222] rounded-xl shadow p-4 border border-[#333333]">
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium">Total Users</span>
        <span class="text-[#db352b]">👤</span>
      </div>
      <div class="text-2xl font-bold">1,284</div>
      <p class="text-xs text-green-500">+12% from last month</p>
    </div>

    <div class="bg-[#222222] rounded-xl shadow p-4 border border-[#333333]">
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium">Active Sessions</span>
        <span class="text-[#db352b]">🖥️</span>
      </div>
      <div class="text-2xl font-bold">18</div>
      <p class="text-xs text-[#db352b]">25 computers available</p>
    </div>

    <div class="bg-[#222222] rounded-xl shadow p-4 border border-[#333333]">
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium">Today's Revenue</span>
        <span class="text-[#db352b]">💲</span>
      </div>
      <div class="text-2xl font-bold text-green-500">$324</div>
      <p class="text-xs text-green-500">+8% from yesterday</p>
    </div>

    <div class="bg-[#222222] rounded-xl shadow p-4 border border-[#333333]">
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm font-medium">System Health</span>
        <span class="text-[#db352b]">📈</span>
      </div>
      <div class="text-2xl font-bold">94%</div>
      <div class="w-full bg-gray-700 h-2 rounded mt-2">
        <div class="bg-[#db352b] h-2 rounded" style="width:94%"></div>
      </div>
    </div>

  </div>

  <!-- Main Content -->
  <div class="flex-1 overflow-auto p-6 space-y-6">

    <!-- Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <div class="bg-[#222222] rounded-xl shadow p-4 border border-[#333333]">
        <h2 class="font-oswald text-lg mb-1">MONTHLY REVENUE</h2>
        <p class="text-gray-400 text-sm mb-4">Revenue and booking trends over the last 6 months</p>
        <div class="bg-gray-700 h-72 flex items-center justify-center text-gray-400 rounded">
          Bar Chart Placeholder
        </div>
      </div>

      <div class="bg-[#222222] rounded-xl shadow p-4 border border-[#333333]">
        <h2 class="font-oswald text-lg mb-1">COMPUTER STATUS</h2>
        <p class="text-gray-400 text-sm mb-4">Current status of all computers in the cafe</p>
        <div class="bg-gray-700 h-72 flex items-center justify-center text-gray-400 rounded">
          Pie Chart Placeholder
        </div>
        <div class="grid grid-cols-2 gap-2 mt-4 text-sm">
          <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-green-500"></span>Available: 25</div>
          <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#db352b]"></span>Occupied: 18</div>
          <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-yellow-500"></span>Maintenance: 3</div>
          <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-gray-500"></span>Offline: 2</div>
        </div>
      </div>

    </div>

    <!-- Recent Activity -->
    <div class="bg-[#222222] rounded-xl shadow p-4 border border-[#333333]">
      <h2 class="font-oswald text-lg mb-1">RECENT ACTIVITY</h2>
      <p class="text-gray-400 text-sm mb-4">Live feed of system activities and user actions</p>
      <div class="space-y-4">

        <div class="flex justify-between items-center p-3 rounded-lg border border-gray-700">
          <div class="flex items-center gap-3">
            <span class="text-[#db352b]">⏰</span>
            <div>
              <p class="text-sm">Started 2-hour gaming session</p>
              <p class="text-xs text-gray-400">Alex Johnson</p>
            </div>
          </div>
          <span class="text-xs text-gray-400">2 min ago</span>
        </div>

        <div class="flex justify-between items-center p-3 rounded-lg border border-gray-700">
          <div class="flex items-center gap-3">
            <span class="text-green-500">✔️</span>
            <div>
              <p class="text-sm">Completed internet session</p>
              <p class="text-xs text-gray-400">Sarah Williams</p>
            </div>
          </div>
          <span class="text-xs text-gray-400">5 min ago</span>
        </div>

        <div class="flex justify-between items-center p-3 rounded-lg border border-gray-700">
          <div class="flex items-center gap-3">
            <span class="text-blue-400">💲</span>
            <div>
              <p class="text-sm">Purchased gaming package</p>
              <p class="text-xs text-gray-400">Mike Chen</p>
            </div>
          </div>
          <span class="text-xs text-gray-400">12 min ago</span>
        </div>

        <div class="flex justify-between items-center p-3 rounded-lg border border-gray-700">
          <div class="flex items-center gap-3">
            <span class="text-[#db352b]">⏰</span>
            <div>
              <p class="text-sm">Extended session by 1 hour</p>
              <p class="text-xs text-gray-400">Emma Davis</p>
            </div>
          </div>
          <span class="text-xs text-gray-400">18 min ago</span>
        </div>

        <div class="flex justify-between items-center p-3 rounded-lg border border-gray-700">
          <div class="flex items-center gap-3">
            <span class="text-yellow-500">⚠️</span>
            <div>
              <p class="text-sm">PC-15 requires maintenance</p>
              <p class="text-xs text-gray-400">System Alert</p>
            </div>
          </div>
          <span class="text-xs text-gray-400">25 min ago</span>
        </div>

      </div>
    </div>

  </div>
</div>
{% endblock %}
