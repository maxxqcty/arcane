{{ form_start(form, {
    'action': path(customer is defined and customer.id ? 'app_customer_edit' : 'app_customer_new', 
        customer is defined and customer.id ? {'id': customer.id} : {}
    ),
    'method': 'POST',
    'attr': {'class': 'space-y-6'}
}) }}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {% for child in form %}
        {% if child.vars.name != '_token' %}
            <div>
                {{ form_label(child, null, {
                    'label_attr': {'class': 'block text-sm font-medium text-[#DB352B] mb-1'}
                }) }}
                {{ form_widget(child, {
                    'attr': {
                        'class': 'w-full rounded-lg border border-[#DB352B] bg-[#181818] px-3 py-2 text-white placeholder-[#DB352B] focus:outline-none focus:ring-2 focus:ring-[#DB352B] focus:border-[#DB352B]'
                    }
                }) }}
                {{ form_errors(child, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>
        {% endif %}
    {% endfor %}
</div>

{{ form_row(form._token) }}

<div class="flex justify-end mt-6">
    <button type="submit"
        class="rounded-lg bg-[#DB352B] px-5 py-2.5 text-white font-medium shadow hover:bg-red-700 transition-colors">
        {{ button_label|default('Save') }}
    </button>
</div>

{{ form_end(form, { 'render_rest': false }) }}
