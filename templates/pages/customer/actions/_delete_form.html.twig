<form method="post" action="{{ path('app_customer_delete', {'id': customer.id}) }}" 
      onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ customer.id) }}">
    
    <button type="submit"
            class="relative inline-flex items-center justify-center px-6 py-3 rounded-full bg-red-600 text-white font-semibold text-sm shadow-lg transition-all duration-300 
                   hover:bg-red-500 hover:shadow-2xl active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Delete
    </button>
</form>
