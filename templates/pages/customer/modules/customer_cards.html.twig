

    <!-- Customer Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for customer in customers %}
       <div 
    class="customer-card rounded-2xl bg-[#222222] shadow-lg hover:shadow-2xl transition-all duration-300 border border-[#333333] overflow-hidden"
    data-name="{{ customer.name|lower }}"
    data-code="{{ customer.customerCode|lower }}"
    data-status="{{ customer.status.name|lower }}"
    data-membership="{{ customer.membership.type|lower }}"
>
            <div class="p-6 flex flex-col h-full justify-between">

                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
                    <div class="flex items-center gap-3 flex-wrap">
                        <h3 class="font-oswald text-xl text-white">{{ customer.name }}</h3>
                         <!-- Status Badge -->
                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold
                        {% if customer.status.name == 'Active' %}
                            bg-green-500/20 text-green-400 border-green-700/50
                        {% elseif customer.status.name == 'Inactive' %}
                            bg-gray-500/20 text-gray-400 border-gray-700/50
                        {% elseif customer.status.name == 'Banned' %}
                            bg-red-500/20 text-red-400 border-red-700/50
                        {% else %}
                            bg-yellow-500/20 text-yellow-400 border-yellow-700/50
                        {% endif %}
                    ">
                        {{ customer.status.name|upper }}
                    </span>
                    <!-- Membership Badge -->
<span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold
    {% if customer.membership.type == 'Silver' %}
        bg-gray-400/20 text-gray-300 border-gray-600/50
    {% elseif customer.membership.type == 'Gold' %}
        bg-yellow-400/20 text-yellow-300 border-yellow-600/50
    {% elseif customer.membership.type == 'Platinum' %}
        bg-blue-400/20 text-blue-300 border-blue-600/50
    {% else %}
        bg-purple-500/20 text-purple-400 border-purple-700/50
    {% endif %}
">
    {{ customer.membership.type|upper }}
</span>
                    </div>
                    <span class="text-sm text-[#b0b0b0] font-mono">{{ customer.customerCode }}</span>
                </div>

              <!-- Customer Info Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-gray-300 mb-4">

    <div class="relative pl-7 truncate">
        <svg class="absolute top-0 left-0 h-5 w-5 text-orange-400" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
        </svg>
        <span>{{ customer.email }}</span>
    </div>

    <div class="relative pl-7">
        <svg class="absolute top-0 left-0 h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 3.08 2h3a2 2 0 0 1 2 1.72"/>
        </svg>
        <span>{{ customer.phone }}</span>
    </div>

    <div class="relative pl-7">
        <svg class="absolute top-0 left-0 h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
            <line x1="16" y1="2" x2="16" y2="6" />
            <line x1="8" y1="2" x2="8" y2="6" />
            <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
        <span>Joined: {{ customer.joinedAt ? customer.joinedAt|date('Y-m-d') : 'N/A' }}</span>
    </div>

    <div class="relative pl-7">
        <svg class="absolute top-0 left-0 h-5 w-5 text-purple-400" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Last visit: {{ customer.lastVisit ? customer.lastVisit|date('Y-m-d') : 'N/A' }}</span>
    </div>

    <div class="relative pl-7">
        <svg class="absolute top-0 left-0 h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" x2="12" y1="2" y2="22"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
        </svg>
        <span>Total spent: <span class="text-green-500 font-semibold">${{ customer.totalSpent }}</span></span>
    </div>

    <div class="relative pl-7">
        <svg class="absolute top-0 left-0 h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Total hours: <span class="text-blue-500 font-semibold">{{ customer.totalHours }}h</span></span>
    </div>

</div>


                <!-- Action Buttons -->
                <div class="flex gap-2 mt-auto">
                   <button 
    data-edit-url="{{ path('app_customer_edit', {'id': customer.id}) }}"
    class="flex-1 rounded-lg bg-transparent border border-[#db352b] text-[#db352b] px-4 py-2 text-sm font-medium text-center hover:bg-[#db352b]/10 transition open-edit-modal">
    Edit
</button>

                <button 
    data-show-url="{{ path('app_customer_show', {'id': customer.id}) }}"
    class="flex-1 rounded-lg bg-red-900/10 border border-red-500/50 text-red-400 px-4 py-2 text-sm font-medium text-center hover:bg-red-900/20 transition open-show-modal">
    Show
</button>
                </div>

            </div>
        </div>
        {% else %}
        <p class="text-[#b0b0b0]">No customers found.</p>
        {% endfor %}
    </div>
</div>
