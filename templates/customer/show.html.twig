{% block title %}{% endblock %}

{% block body %}
<!-- Modal Overlay -->
<div class="fixed inset-0 flex items-center justify-center z-50">
    <!-- Modal Container -->
    <div class="bg-[#1e1e1e] text-white rounded-2xl shadow-2xl w-full max-w-3xl p-8 relative border border-[#2b2b2b]">

        <!-- Close Button -->
        <button class="absolute top-4 right-4 text-gray-400 hover:text-white close-modal transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-oswald font-bold text-[#db352b] tracking-wide">Customer Details</h1>
            <p class="text-[#b0b0b0] text-sm mt-1">Detailed overview of customer information</p>
        </div>

        <!-- Customer Info Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
            
            <!-- Name -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Name</p>
                <p class="font-semibold text-white text-base mt-1">{{ customer.name }}</p>
            </div>

            <!-- Status -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Status</p>
                <span class="inline-flex items-center rounded-full border px-2 py-0.5 mt-1 text-xs font-semibold 
                    {% if customer.status == 'Active' %}bg-green-500/15 text-green-400 border-green-700/40
                    {% else %}bg-yellow-500/15 text-yellow-400 border-yellow-700/40{% endif %}">
                    {{ customer.status|upper }}
                </span>
            </div>

            <!-- Membership -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Membership</p>
                <span class="inline-flex items-center rounded-full border px-2 py-0.5 mt-1 text-xs font-semibold 
                    {% if customer.membership == 'VIP' %}bg-amber-500/15 text-amber-400 border-amber-700/40
                    {% elseif customer.membership == 'Premium' %}bg-purple-500/15 text-purple-400 border-purple-700/40
                    {% else %}bg-blue-500/15 text-blue-400 border-blue-700/40{% endif %}">
                    {{ customer.membership|upper }}
                </span>
            </div>

            <!-- Customer Code -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Customer Code</p>
                <p class="font-mono text-[#db352b] text-base mt-1">{{ customer.customerCode }}</p>
            </div>

            <!-- Email -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Email</p>
                <p class="truncate mt-1">{{ customer.email }}</p>
            </div>

            <!-- Phone -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Phone</p>
                <p class="mt-1">{{ customer.phone }}</p>
            </div>

            <!-- Joined At -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Joined At</p>
                <p class="mt-1">{{ customer.joinedAt ? customer.joinedAt|date('Y-m-d H:i') : 'N/A' }}</p>
            </div>

            <!-- Last Visit -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Last Visit</p>
                <p class="mt-1">{{ customer.lastVisit ? customer.lastVisit|date('Y-m-d H:i') : 'N/A' }}</p>
            </div>

            <!-- Total Spent -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Total Spent</p>
                <p class="text-green-400 font-semibold text-base mt-1">${{ customer.totalSpent|number_format(2) }}</p>
            </div>

            <!-- Total Hours -->
            <div class="bg-[#262626] p-4 rounded-xl border border-[#333333]">
                <p class="text-[#b0b0b0] text-xs uppercase">Total Hours</p>
                <p class="text-blue-400 font-semibold text-base mt-1">{{ customer.totalHours }}h</p>
            </div>
        </div>

        <!-- Footer Buttons -->
        <div class="mt-8 flex justify-between items-center border-t border-[#333333] pt-6">
            <a href="{{ path('app_customer_index') }}"
               class="bg-gray-600 hover:bg-gray-500 text-white px-5 py-2.5 rounded-xl text-sm font-medium transition">
                Back
            </a>

            <div class="flex gap-2">
                <a href="{{ path('app_customer_edit', {'id': customer.id}) }}"
                   class="bg-[#db352b] hover:bg-[#c52f26] text-white px-5 py-2.5 rounded-xl text-sm font-medium transition">
                    Edit
                </a>
                {{ include('customer/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
