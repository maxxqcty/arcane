{% extends 'base.html.twig' %}

{% block title %}Customer{% endblock %}

{% block body %}
    <h1>Customer</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ customer.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ customer.name }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ customer.status }}</td>
            </tr>
            <tr>
                <th>Membership</th>
                <td>{{ customer.membership }}</td>
            </tr>
            <tr>
                <th>Customer_code</th>
                <td>{{ customer.customerCode }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ customer.email }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ customer.phone }}</td>
            </tr>
            <tr>
                <th>Joined_at</th>
                <td>{{ customer.joinedAt ? customer.joinedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Last_visit</th>
                <td>{{ customer.lastVisit ? customer.lastVisit|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Total_spent</th>
                <td>{{ customer.totalSpent }}</td>
            </tr>
            <tr>
                <th>Total_hours</th>
                <td>{{ customer.totalHours }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_customer_index') }}">back to list</a>

    <a href="{{ path('app_customer_edit', {'id': customer.id}) }}">edit</a>

    {{ include('customer/_delete_form.html.twig') }}
{% endblock %}
