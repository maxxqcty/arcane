{% extends 'base.html.twig' %}

{% block title %}Customer Management{% endblock %}

{% block body %}
<!-- Import Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<div class="p-6 font-roboto bg-[#181818] min-h-screen">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="font-oswald text-3xl tracking-wide text-white mb-2">CUSTOMER MANAGEMENT</h1>
            <p class="text-[#b0b0b0]">Manage customer accounts, memberships, and information</p>
        </div>

        <a href="{{ path('app_customer_new') }}" class="inline-flex items-center justify-center rounded-lg text-sm font-medium transition-colors h-10 py-2 px-4 bg-[#db352b] text-white shadow-md w-full lg:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 mr-2">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Add Customer
        </a>
    </div>


<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Total Customers -->
    <div class="bg-[#222222] rounded-xl shadow p-6 flex flex-col items-start hover:shadow-2xl transition">
        <p class="text-sm text-[#b0b0b0]">Total Customers</p>
        <h2 class="font-oswald text-2xl text-white mt-2">1234</h2>
    </div>

    <!-- VIP Members -->
    <div class="bg-[#222222] rounded-xl shadow p-6 flex flex-col items-start hover:shadow-2xl transition">
        <p class="text-sm text-[#b0b0b0]">VIP Members</p>
        <h2 class="font-oswald text-2xl text-white mt-2">567</h2>
    </div>

    <!-- Inactive Users -->
    <div class="bg-[#222222] rounded-xl shadow p-6 flex flex-col items-start hover:shadow-2xl transition">
        <p class="text-sm text-[#b0b0b0]">Inactive Users</p>
        <h2 class="font-oswald text-2xl text-white mt-2">89</h2>
    </div>

    <!-- Total Revenue -->
    <div class="bg-[#222222] rounded-xl shadow p-6 flex flex-col items-start hover:shadow-2xl transition">
        <p class="text-sm text-[#b0b0b0]">Total Revenue</p>
        <h2 class="font-oswald text-2xl text-green-400 mt-2">$12,345</h2>
    </div>
</div>

    <!-- Customer Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for customer in customers %}
        <div class="rounded-2xl bg-[#222222] shadow-lg hover:shadow-2xl transition-all duration-300 border border-[#333333] overflow-hidden">
            <div class="p-6 flex flex-col h-full justify-between">

                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
                    <div class="flex items-center gap-3 flex-wrap">
                        <h3 class="font-oswald text-xl text-white">{{ customer.name }}</h3>
                        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold {% if customer.status == 'Active' %}bg-green-500/20 text-green-400 border-green-700/50{% else %}bg-yellow-500/20 text-yellow-400 border-yellow-700/50{% endif %}">
                            {{ customer.status|upper }}
                        </span>
                        <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold {% if customer.membership == 'Premium' %}bg-purple-500/20 text-purple-400 border-purple-700/50{% elseif customer.membership == 'VIP' %}bg-amber-500/20 text-amber-400 border-amber-700/50{% else %}bg-blue-500/20 text-blue-400 border-blue-700/50{% endif %}">
                            {{ customer.membership|upper }}
                        </span>
                    </div>
                    <span class="text-sm text-[#b0b0b0] font-mono">{{ customer.customerCode }}</span>
                </div>

                <!-- Customer Info Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-[#b0b0b0] mb-4">
                    <div class="flex items-center gap-2 truncate">
                        <svg class="h-4 w-4 text-[#b0b0b0] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <span class="truncate">{{ customer.email }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-[#b0b0b0] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 3.08 2h3a2 2 0 0 1 2 1.72"/></svg>
                        <span>{{ customer.phone }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-[#b0b0b0] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <span>Joined: {{ customer.joinedAt ? customer.joinedAt|date('Y-m-d') : 'N/A' }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-[#b0b0b0] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span>Last visit: {{ customer.lastVisit ? customer.lastVisit|date('Y-m-d') : 'N/A' }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-[#b0b0b0] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        <span>Total spent: <span class="text-green-400 font-semibold">${{ customer.totalSpent }}</span></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-[#b0b0b0] flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span>Total hours: <span class="text-blue-400 font-semibold">{{ customer.totalHours }}h</span></span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex gap-2 mt-auto">
                    <a href="{{ path('app_customer_edit', {'id': customer.id}) }}" class="flex-1 rounded-lg bg-transparent border border-[#db352b] text-[#db352b] px-4 py-2 text-sm font-medium text-center hover:bg-[#db352b]/10 transition">
                        Edit
                    </a>
                    <a href="{{ path('app_customer_show', {'id': customer.id}) }}" class="flex-1 rounded-lg bg-red-900/10 border border-red-500/50 text-red-400 px-4 py-2 text-sm font-medium text-center hover:bg-red-900/20 transition">
                        Show
                    </a>
                </div>

            </div>
        </div>
        {% else %}
        <p class="text-[#b0b0b0]">No customers found.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
